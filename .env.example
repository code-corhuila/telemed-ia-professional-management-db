# Environment variables for the Professional Management database.
# Copy this file to .env and set real values before starting the
# deployment compose. `.env` is ignored by Git and must never be
# committed. Every variable below is a placeholder; none of these
# values should be used as-is in any environment.

# Database name created by the PostgreSQL image on first start.
# Set a real name for your environment.
POSTGRES_DB=<set-me>

# Superuser role created by the PostgreSQL image on first start.
# Set a real role name for your environment.
POSTGRES_USER=<set-me>

# Password for the superuser role. Use a real random value in .env.
# Example: generate one with `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Host port mapped to the container's 5432. Optional; 5432 is the
# default.
POSTGRES_PORT=5432

# User created and used by the test runner. Fixed value expected by
# `docker-compose.test.yml` (see the `POSTGRES_USER` environment of the
# `postgres` service in that file). Do not change it without also
# changing the compose file.
TEST_DB_USER=test_user

# Password generated at test time by the runner. Do not set a value
# here; the runner generates one per execution and discards it.
TEST_DB_PASSWORD=
