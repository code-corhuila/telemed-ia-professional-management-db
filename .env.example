# Environment variables for telemed-ia-professional-management-db.
# These are NOT defined by this repo. They come from the infra env file
# of telemed-ia-infra-postgres:
#     env/dev.env   (development)
#     env/qa.env    (qa)
#     env/main.env  (main)
# This file only documents which variables must exist there. Do not
# commit real secrets.

# Shared PostgreSQL database name (defined in infra)
PG_DATABASE=telemed_ia

# Password for the professional_management_app role (defined in infra)
PROFESSIONAL_MANAGEMENT_APP_PASSWORD=change-me

# Optional override of the application user name.
# Default: professional_management_app
PROFESSIONAL_MANAGEMENT_APP_USER=professional_management_app

# Test-only variables ---------------------------------------------------
# Used ONLY by docker-compose.test.yml for isolated tests, not in dev,
# qa, or main.

# Test user created inside the ephemeral test PostgreSQL instance.
TEST_DB_USER=test_user

# Password generated at test time by the runner. Leave empty.
TEST_DB_PASSWORD=
